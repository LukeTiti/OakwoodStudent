{
  "manifest_version": 3,
  "name": "Oakwood Advisor – Veracross Bridge",
  "version": "0.11.0",
  "description": "Lets Oakwood advisors review pending community service submissions and post approved hours to Veracross.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://axiom.veracross.com/*",
    "https://firestore.googleapis.com/*"
  ]
}
