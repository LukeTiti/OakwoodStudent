rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /serviceForms/{formId} {
      // Single-document reads by ID stay open — needed for the public /sign/<id> link a
      // supervisor clicks with no account of their own. Firestore auto-IDs aren't guessable
      // or enumerable, so this alone was never the bulk-read vector; unrestricted `list` was.
      allow get: if true;

      // Bulk queries are the actual bulk-dump vector (proven earlier: one unfiltered request
      // returned every student's name, hours, reflections, supervisor email, and signature
      // image). Firestore can only prove a `list` is safe when the query itself is filtered on
      // a value the rule can check, so only two shapes are allowed:
      //   - a signed-in student querying strictly their own forms (the app's "My Forms")
      //   - a query filtered to status == 'pending' (the advisor extension/portal queue —
      //     see chrome-extension/popup.js's fetchPendingForms and advisor/index.html, both
      //     updated to send a real structured query instead of an unfiltered fetch-and-filter)
      // Anything else — an unfiltered dump, or querying someone else's studentId — is rejected.
      allow list: if (request.auth != null && resource.data.studentId == request.auth.token.email)
        || resource.data.status == 'pending';

      // A new form must be created by its own signed-in student and must start in the correct
      // initial state — stops someone from writing a document straight into "approved" and
      // skipping the entire supervisor-signature / advisor-approval flow.
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.token.email
        && request.resource.data.status == 'pending_signature';

      // Nothing in the app or extension ever deletes a form — closing this stops anyone from
      // wiping the whole collection with an unauthenticated request.
      allow delete: if false;

      // The public /sign/<id> page (public/sign/index.html) is unauthenticated by design — an
      // outside supervisor clicks an emailed link with no account of their own. Its own JS only
      // ever writes these 5 fields on a pending_signature -> pending transition, but that page's
      // Firebase config (project ID + API key) is plainly visible via "View Source", so nothing
      // stops someone from skipping the page's UI entirely and firing a raw Firestore write with
      // the same credentials. This rule is what actually enforces the narrow shape server-side,
      // regardless of how the write is sent — the page's own JS was never a real boundary.
      //
      // Every other status transition on this collection (resubmission, advisor approve/reject,
      // submitFormToAdvisor, the Veracross record-id write-back) is untouched by this rule, since
      // none of them start from "pending_signature".
      allow update: if resource.data.status != 'pending_signature'
        || (
          request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['supervisorSignature', 'supervisorTitle', 'signerEmail', 'signatureImage', 'signedAt', 'status'])
        );
    }

    // Everything else (every other collection) is unchanged from before this rule — see the
    // app's own security review notes for why that's still an open item, tracked separately.
    //
    // Must exclude serviceForms explicitly: Firestore ORs every `match` block that applies to
    // a given path rather than letting a narrower block override a broader one, so a blanket
    // `match /{document=**}` here would silently grant serviceForms writes regardless of what
    // the block above says (confirmed the hard way — this exact mistake shipped once already).
    match /{collection}/{document=**} {
      allow read, write: if collection != 'serviceForms';
    }
  }
}
